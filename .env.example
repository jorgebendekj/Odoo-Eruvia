# ==========================================
# Configuración de Entorno - Eruvia Odoo ERP
# ==========================================

# Dominio público (asegúrate de que apunte a la IP de tu Droplet en DigitalOcean)
DOMAIN_NAME=crm.eruvia.com

# Contraseña de la base de datos PostgreSQL (usa una cadena segura y aleatoria)
POSTGRES_PASSWORD=CambiaEstaContrasenaPorUnaMuySegura123!

# Contraseña Maestra de Odoo (para crear/respaldar bases de datos desde el navegador)
ADMIN_PASSWORD=SuperMasterPasswordOdoo2026!
