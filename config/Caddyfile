odoo.eruviabs.com {
    encode gzip zstd

    # 1. Remote MCP Endpoints
    handle /mcp* {
        reverse_proxy remote_mcp:8000 {
            flush_interval -1
            header_up Host {host}
            header_up X-Forwarded-Proto https
        }
    }

    handle /sse* {
        reverse_proxy remote_mcp:8000 {
            flush_interval -1
            header_up Host {host}
            header_up X-Forwarded-Proto https
        }
    }

    handle /messages* {
        reverse_proxy remote_mcp:8000 {
            flush_interval -1
            header_up Host {host}
            header_up X-Forwarded-Proto https
        }
    }

    # 2. Odoo ERP / CRM Web
    handle {
        @websocket {
            header Connection *Upgrade*
            header Upgrade websocket
        }
        reverse_proxy @websocket odoo:8069

        reverse_proxy odoo:8069 {
            header_up X-Forwarded-Proto https
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
        }
    }

    log {
        output stdout
        format console
    }
}
